# Required for ALL pages/APIs. Missing/short credentials fail closed (503).
OARS_ADMIN_USER=
OARS_ADMIN_PASSWORD=
# Use a randomly generated password at least 20 characters long. Never NEXT_PUBLIC_.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
# Must match Cafe24 app OAuth registration and this deployment origin.
CAFE24_REDIRECT_URI=
# line = 판매가 already contains the item-row total; unit = per-unit price.
# Leave unset until verified: existing line-total convention + visible warning.
OARS_SALES_PRICE_MODE=
# Earliest date for which the sheet is known to contain ALL orders.
# Earliest observed order is not sufficient proof. YYYY-MM-DD (Korea date).
OARS_ORDER_COVERAGE_START=
